# Supabase (local values: `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS: `simulator` (default) or `smsgate`
SMS_GATEWAY=simulator
# Optional: defaults to the SMSGate cloud (https://api.sms-gate.app/3rdparty/v1).
# Private server: https://<host>/api/3rdparty/v1
SMS_GATEWAY_URL=
# From SMS Gateway Android app > Home > Cloud Server.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Optional with one device; recommended to explicitly select the gateway phone.
SMS_GATEWAY_DEVICE_ID=
# Optional: 1 or 2 (SIM slot, not textbee's subscription ID).
SMS_GATEWAY_SIM_NUMBER=
# Optional: the gateway phone's number, shown on the landing page.
SMS_GATEWAY_PHONE_NUMBER=
# From Android app > Settings > Webhooks > Signing Key. Used by the webhook
# relay (services/sms-webhook), not this app.
SMS_GATEWAY_WEBHOOK_SIGNING_KEY=
# Shared with the webhook relay (min 16 chars), e.g. `openssl rand -hex 32`.
SMS_RELAY_SECRET=
SMS_GATEWAY_WEBHOOK_PORT=3000

# Gemini (optional; AI falls back to templates)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional comma-separated pool; takes precedence over the single key above.
# Use keys from separate Google projects: keys in one project share its quota.
GOOGLE_GENERATIVE_AI_API_KEYS=
# Local per-key request budgets; set these to match your model/tier in AI Studio.
# Defaults below are app budgets, not a claim about Google's quota for any model.
# Counters are per server instance; daily counters reset at midnight Asia/Manila.
GOOGLE_GENERATIVE_AI_RPM_LIMIT=10
GOOGLE_GENERATIVE_AI_RPD_LIMIT=250
# Switch after this fraction of either budget has been used (0 < value <= 1).
GOOGLE_GENERATIVE_AI_QUOTA_THRESHOLD=0.9

# Optional preferred provider: OpenRouter -> Gemini -> another eligible Gemini key.
# Also works alone when no Gemini key is configured. Choose a model that supports
# structured outputs; the default is a paid, small OpenAI model on OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-nano
